{
  "name": "hearthworks",
  "version": "0.1.0",
  "private": true,
  "description": "2D web town builder where villagers plan and build their own civilisation. Design knowledge lives in an OKF bundle.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-site.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.ts\"",
    "gates": "node scripts/gate.ts",
    "fingerprint": "node scripts/fingerprint.ts",
    "okf": "node scripts/okf.ts",
    "okf:check": "node scripts/okf.ts --check",
    "ci": "npm run okf:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3"
  }
}
